{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "url": ["http://localhost:3000/en", "http://localhost:3000/ar"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/en$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/ar$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
